# IQRA TCS Employee Caller App — Environment Configuration
# Copy this file to `.env` for local development overrides.

# Application environment: "development" | "production"
APP_ENV=development

# Backend API base URL (without trailing slash)
# - Android Emulator talking to host Django server: http://10.0.2.2:8000/api/v1
# - Physical Android device on LAN: http://<LAN_IP>:8000/api/v1
# - Production (HTTPS required): https://iqracentral.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
