# IQRA TCS Calling CRM — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Django Core ─────────────────────────────────────────────────────────────
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-long-random-secret-key

DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,iqracentral.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://iqra_user:change_me@localhost:5432/iqra_tcs_crm
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=True

# ─── HTTPS, Cookie & CSRF Production Security ────────────────────────────────
# Enable SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE, and CSRF_COOKIE_SECURE in HTTPS production.
# Keep False for local plain-HTTP development (http://localhost:8000).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
CSRF_TRUSTED_ORIGINS=https://iqracentral.com,https://www.iqracentral.com

# HSTS: Leave at 0 until HTTPS is verified on iqracentral.com.
# Once HTTPS is verified in production, set SECURE_HSTS_SECONDS=31536000 (1 year).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests
CORS_ALLOWED_ORIGINS=https://iqracentral.com
# Set to True ONLY during local development when you need to allow all origins
CORS_ALLOW_ALL_ORIGINS=False

# ─── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO

# ─── Shared Cache, Reverse-Proxy Trust & Admin Web CRM Login Rate Limiting ───
# By default, IQRA TCS uses the shared PostgreSQL database (PostgresAtomicCache)
# for multi-worker /crm/login/ rate limiting (CACHES["crm_ratelimit"]).
# CACHE_URL configures CACHES["default"] (used by DRF throttling) and never
# alters CACHES["crm_ratelimit"].
# CACHE_URL=
# CRM_SHARED_CACHE_TABLE must match [A-Za-z_][A-Za-z0-9_]{0,45}
CRM_SHARED_CACHE_TABLE=iqra_shared_cache
# All three rate-limit integers below are validated at startup and must be >= 1
CRM_LOGIN_MAX_ATTEMPTS=5
CRM_LOGIN_MAX_IP_ATTEMPTS=5
CRM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# X-Forwarded-For and X-Forwarded-Proto are ignored by default (False).
# Even when True, they are only trusted if CRM_TRUSTED_PROXY_IPS is non-empty
# (comma-separated proxy IPs or CIDRs, e.g. 127.0.0.1).
CRM_TRUST_X_FORWARDED_FOR=False
CRM_TRUST_X_FORWARDED_PROTO=False
CRM_TRUSTED_PROXY_IPS=
